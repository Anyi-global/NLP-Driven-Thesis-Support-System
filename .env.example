# REQUIRED in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH_MB=
SESSION_TIMEOUT_MINUTES=

# --- AI evaluation. Model names are retired regularly; pick current ones from
# https://ai.google.dev/gemini-api/docs/deprecations  (the old default gemini-2.5-flash is deprecated).
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=

# --- Background analysis (single-process thread pool; use a real queue for multi-worker deployments)
ANALYSIS_ASYNC=
ANALYSIS_WORKERS=

# --- Web security
SESSION_COOKIE_SECURE=          # set to 1 when served over HTTPS
SESSION_COOKIE_SAMESITE=      # "None" only with SECURE=1 and a cross-site frontend
CORS_ORIGINS=                    # comma-separated frontend origins, e.g. https://thesis.example.edu
CSRF_ENABLED=
RATE_LIMIT_ENABLED=
TRUSTED_PROXY_COUNT=            # number of reverse proxies in front of the app

# --- Optional language engines (see requirements-optional.txt)
LANGUAGETOOL_ENABLED=          # 1 = run the British-English grammar/spelling check (needs Java)
LANGUAGETOOL_URL=                # or the URL of a self-hosted LanguageTool server
LANGUAGETOOL_MAX_CHARS=
